      "timeout_seconds": 60
    },
    {
      "id": "sqlite-free-observability-validator",
      "command": ["{python}", "docs/validation/check_obs_query.py"],
      "timeout_seconds": 60
    },
    {
      "id": "sandbox-source-contract-validator",
      "command": ["{python}", "docs/validation/check_sandbox_source_contract.py"],
      "timeout_seconds": 60
    },
    {
      "id": "executor-supervisor-and-pi-adapter-validator",
